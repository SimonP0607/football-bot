# ──────────────────────────────────────────────────────────────────────────────
# football-bot — Variables de entorno
# Copia este archivo como .env y completa los valores marcados con <COMPLETAR>
# NUNCA subas .env al repositorio (ya está en .gitignore)
# ──────────────────────────────────────────────────────────────────────────────

# ── Entorno ───────────────────────────────────────────────────────────────────
APP_ENV=local        # local | production
LOG_LEVEL=INFO       # DEBUG | INFO | WARNING | ERROR

# ── Telegram ──────────────────────────────────────────────────────────────────
# 1. Abre Telegram → busca @BotFather → /newbot → sigue las instrucciones
# 2. Copia el token que te da BotFather (formato: 1234567890:AABBcc...)
TELEGRAM_BOT_TOKEN=<COMPLETAR>

# Tu ID numérico de Telegram (entero, NO el @username)
# Deja en 0 durante el setup inicial; el bot arrancará en modo bootstrap.
# Envía /id al bot para descubrirlo.
TELEGRAM_ALLOWED_USER_ID=0

# ── Supabase ──────────────────────────────────────────────────────────────────
# En Supabase → tu proyecto → Project Settings → API
SUPABASE_URL=<COMPLETAR>

# Usa la clave service_role (NO la anon key) — tiene acceso completo
SUPABASE_KEY=<COMPLETAR>

# ── API-Football ──────────────────────────────────────────────────────────────
# URL base de la API (no cambies esto salvo que uses un proxy)
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# Clave de API-Football (https://www.api-football.com → Dashboard → Credenciales)
API_FOOTBALL_KEY=<COMPLETAR>

# ── Configuración del bot ─────────────────────────────────────────────────────
# Zona horaria IANA para calcular "hoy" y mostrar horarios locales
DEFAULT_TIMEZONE=America/Bogota

# Mercados habilitados: 1X2 = Resultado | OU25 = Más/Menos 2.5 | BTTS = Ambos anotan
DEFAULT_MARKETS=1X2,OU25,BTTS

# Máximo de picks publicables por día (global, no por fixture)
MAX_DAILY_PICKS=3

# Umbral mínimo de edge para publicar un pick (0.05 = 5%)
MIN_EDGE=0.05

# Probabilidad mínima del modelo para publicar un pick (0.60 = 60%)
MIN_CONFIDENCE=0.60

# ── Bookmaker preferido (opcional) ────────────────────────────────────────────
# Si se configura, el sistema priorizará este bookmaker para cuotas.
# Usa el nombre exacto como aparece en /odds/bookmakers (ej: "Bet365").
# Deja vacío para usar el mejor precio disponible entre todos.
PREFERRED_BOOKMAKER=

# ID numérico del bookmaker preferido (más eficiente que el nombre).
# Encuéntralo en ref_bookmakers tras sync_reference.py, o en /odds/bookmakers.
# 0 = sin preferencia.
PREFERRED_BOOKMAKER_ID=0

# ── Configuración de sync ─────────────────────────────────────────────────────
# IDs de ligas de API-Football a sincronizar (separados por coma)
# Ejemplos:
#   39  = Premier League        140 = La Liga
#   135 = Serie A               78  = Bundesliga
#   61  = Ligue 1               253 = Liga BetPlay (Colombia)
DEFAULT_LEAGUE_IDS=<COMPLETAR>

# Temporadas por liga (formato: league_id:season_year, separados por coma).
# Necesario porque las ligas europeas y colombianas usan años distintos.
#   Europa  → 2025 (temporada 2024/25 o 2025/26 según la liga)
#   Colombia → 2026 (temporada calendario)
# Ejemplo: LEAGUE_SEASONS=39:2025,140:2025,135:2025,78:2025,61:2025,253:2026
LEAGUE_SEASONS=<COMPLETAR>

# Temporada de respaldo para ligas no listadas en LEAGUE_SEASONS.
# Deja en 0 si todas las ligas están en LEAGUE_SEASONS.
DEFAULT_SEASON=0
