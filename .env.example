# ──────────────────────────────────────────────────────────────────────────────
# football-bot — Variables de entorno
# Copia este archivo como .env y completa los valores marcados con <COMPLETAR>
# NUNCA subas .env al repositorio (ya está en .gitignore)
# ──────────────────────────────────────────────────────────────────────────────

# ── Entorno ───────────────────────────────────────────────────────────────────
APP_ENV=local        # local | production
LOG_LEVEL=INFO       # DEBUG | INFO | WARNING | ERROR

# ── Telegram ──────────────────────────────────────────────────────────────────
# 1. Abre Telegram → busca @BotFather → /newbot → sigue las instrucciones
# 2. Copia el token que te da BotFather (formato: 1234567890:AABBcc...)
TELEGRAM_BOT_TOKEN=8376398286:AAHvCljY6lYKGIRJU5Ul75mZfabg1aqzaxU

# Tu ID numérico de Telegram (entero, NO el @username)
# Cómo obtenerlo:
#   a) Arranca el bot con TELEGRAM_ALLOWED_USER_ID=0 y envía /id al bot
#   b) O mira los logs: aparece en el WARNING de "Acceso no autorizado"
TELEGRAM_ALLOWED_USER_ID=0

# ── Supabase ──────────────────────────────────────────────────────────────────
# En Supabase → tu proyecto → Project Settings → API
# Project URL (termina en .supabase.co)
SUPABASE_URL=https://paptjtjiwbxgcewsczbl.supabase.co

# Usa la clave service_role (NO la anon key) — tiene acceso completo
# La encuentras en Project Settings → API → service_role (secret)
SUPABASE_KEY=sb_secret_MGhyxTtKULM--nTFnry_5w_tVlgF2cl

# ── API-Football ──────────────────────────────────────────────────────────────
# URL base de la API (no cambies esto a menos que uses un proxy)
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# Clave de API-Football
# Regístrate en https://www.api-football.com → Dashboard → Credenciales
API_FOOTBALL_KEY=c1373c4c661ba35b190a79461dbf0b8e

# ── Configuración del bot ─────────────────────────────────────────────────────
# Zona horaria para calcular "hoy" (lista IANA: America/Bogota, America/Lima...)
DEFAULT_TIMEZONE=America/Bogota

# Mercados habilitados (separados por coma, sin espacios)
# 1X2 = Resultado  |  OU25 = Más/Menos 2.5 goles  |  BTTS = Ambos anotan
DEFAULT_MARKETS=1X2,OU25,BTTS

# Máximo de picks publicables por día (global, no por fixture)
MAX_DAILY_PICKS=3

# Umbral mínimo de edge para publicar un pick (0.05 = 5 %)
MIN_EDGE=0.05

# Probabilidad mínima del modelo para publicar un pick (0.60 = 60 %)
MIN_CONFIDENCE=0.60

# ── Configuración de sync ─────────────────────────────────────────────────────
# IDs de ligas de API-Football a sincronizar (separados por coma)
# Ejemplos comunes:
#   39  = Premier League
#   140 = La Liga
#   135 = Serie A
#   78  = Bundesliga
#   61  = Ligue 1
#   253 = Liga BetPlay (Colombia)
DEFAULT_LEAGUE_IDS=<COMPLETAR>

# Temporada activa (año de inicio de la temporada, ej. 2024 para 2024/25)
DEFAULT_SEASON=2025
